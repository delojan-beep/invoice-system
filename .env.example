# Copy to .env.local. Local values come from `pnpm exec supabase status`.

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only: bypasses row-level security. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Base URL used in email links
APP_URL=http://localhost:3000

# Scheduled jobs: Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron.
CRON_SECRET=a-long-random-string

# Email. Production: Resend (RESEND_API_KEY + EMAIL_FROM on a verified domain).
# Local: leave RESEND_API_KEY empty and emails land in Mailpit (http://localhost:54324).
# RESEND_API_KEY=
EMAIL_FROM=QNetwork Invoices <invoices@qnetwork.test>
MAILPIT_URL=http://127.0.0.1:54324

# Exchange rates: empty = not fetched (provider still to be chosen). Known: open-er-api
# FX_PROVIDER=

# Later milestones
# GOOGLE_SA_JSON=
# BACKUP_SHEET_ID=
